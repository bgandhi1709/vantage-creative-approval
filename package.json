{
  "name": "vantage-creative-approval",
  "version": "0.1.0",
  "private": true,
  "description": "Creative approval portal: React SPA, BFF API and Table Storage library in one Nx + MSBuild workspace.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run approval-portal:typecheck",
    "dev": "nx run approval-portal:dev",
    "up": "docker compose -f docker/docker-compose.yml up --build",
    "down": "docker compose -f docker/docker-compose.yml down -v"
  },
  "devDependencies": {
    "nx": "23.2.1"
  }
}
