{
  "_comment": [
    "Local development only. Every value here points at something running on this machine.",
    "The two signing keys are throwaway strings for the local stack; real environments supply",
    "them from the platform's secret store and never from a file in the repository."
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ApprovalTableStorage": "UseDevelopmentStorage=true"
  },
  "Snapshots": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "review-snapshots"
  },
  "Notifications": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromAddress": "reviews@vantage.test",
    "FromName": "Vantage Works"
  },
  "ProducerToken": {
    "Issuer": "vantage-approvals-api",
    "Audience": "vantage-producer-console",
    "SigningKey": "local-development-producer-signing-key",
    "AllowedEmailDomain": "vantage.test",
    "LifetimeMinutes": 60
  },
  "ReviewerSession": {
    "SigningKey": "local-development-reviewer-signing-key",
    "LifetimeDays": 7,
    "CookieName": "vw_review"
  },
  "CampaignSystem": {
    "BaseUrl": "http://localhost:5199",
    "ApiKey": "local-development-campaign-key",
    "TimeoutSeconds": 30
  }
}
