<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Table Storage implementations of the Core repository contracts.
    RootNamespace matches Core on purpose: callers reference one namespace, and whether a type is
    a contract or its storage implementation is an assembly detail, not a using statement.
  -->
  <PropertyGroup>
    <RootNamespace>Vantage.Approvals.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Approvals.Core\Vantage.Approvals.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vantage.Approvals.Api.Tests" />
  </ItemGroup>

</Project>
